###
POST http://localhost:3000/mcp
Content-Type: application/json

{
  "method": "tools/call",
  "params": {
    "name": "search-links",
    "arguments": { "q": "Playwright Bing", "limit": 5, "headless": true }
  },
  "id": "1",
  "jsonrpc": "2.0"
}

###
POST http://localhost:3000/mcp
Content-Type: application/json

{
  "method": "tools/call",
  "params": {
    "name": "extract-page-text",
    "arguments": { "url": "https://playwright.dev/", "headless": true }
  },
  "id": "2",
  "jsonrpc": "2.0"
}

