{
  "manifest_version": 3,
  "name": "MyZ YouTube Danmaku",
  "description": "Turn timestamped YouTube comments into timed danmaku overlays and post new ones with a single click.",
  "version": "0.1.0",
  "permissions": ["tabs"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background/index.js"
  },
  "action": {
    "default_title": "MyZ Danmaku",
    "default_popup": "popup/index.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/bridge.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/index.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
