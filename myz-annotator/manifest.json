{
  "manifest_version": 3,
  "name": "MyZ 网页标注智能助理",
  "description": "All in one knowledge assistant for your web browsing powered by AI.",
  "version": "0.1.5",
  "icons": {
    "16": "assets/icon-128.png",
    "32": "assets/icon-128.png",
    "48": "assets/icon-128.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icon-128.png",
      "24": "assets/icon-128.png",
      "32": "assets/icon-128.png"
    },
    "default_popup": "src/popup/popup.html",
    "default_title": "MyZ Annotator"
  },
  "options_page": "src/dashboard/index.html",
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*.js.map"],
      "matches": ["<all_urls>"]
    }
  ]
}
