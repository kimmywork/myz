{
  "compilerOptions": {
    "target": "es2020",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["DOM", "ESNext"],
    "paths": {
      "@/*": ["./src/*"],
      "@myz/ai-core": ["../packages/ai-core/src/index.ts"],
      "@myz/ai-core/*": ["../packages/ai-core/src/*"],
      "@myz/dashboard-ai-settings": ["../packages/dashboard-ai-settings/src/index.ts"],
      "@myz/dashboard-ai-settings/*": ["../packages/dashboard-ai-settings/src/*"],
      "@myz/dashboard-chat-ui": ["../packages/dashboard-chat-ui/src/index.ts"],
      "@myz/dashboard-chat-ui/*": ["../packages/dashboard-chat-ui/src/*"],
      "@myz/dashboard-ui": ["../packages/dashboard-ui/src/index.ts"],
      "@myz/dashboard-ui/*": ["../packages/dashboard-ui/src/*"],
      "@myz/shared": ["../packages/shared/src/index.ts"],
      "@myz/sync-core/*": ["../packages/sync-core/src/*"],
      "@myz/sync-core": ["../packages/sync-core/src/index.ts"],
      "@myz/shared/*": ["../packages/shared/src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "chrome"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
