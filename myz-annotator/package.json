{
  "name": "myz-annotator",
  "version": "0.6.6",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx --fix",
    "test:dev": "vitest run",
    "test:playwright": "playwright test tests/extension --config=tests/playwright.config.ts",
    "test:e2e": "npm run build && npm run test:playwright",
    "format": "prettier .  --write"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "jest": "*",
    "jsdom": "*",
    "playwright": "*"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "@myz/dashboard-core": "*",
    "@myz/dashboard-ui": "*",
    "@myz/shared": "*",
    "@myz/sync-core": "*",
    "@noble/curves": "*",
    "defuddle": "^0.19.2",
    "dompurify": "^3.4.12",
    "fflate": "*",
    "markdown-it": "^14.3.0",
    "pdfjs-dist": "^6.3.289"
  }
}
