{
  "name": "myz-annotator",
  "version": "0.6.7",
  "type": "module",
  "scripts": {
    "build": "node ../scripts/check-version.mjs && vue-tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx --fix",
    "test:dev": "vitest run",
    "test:playwright": "playwright test tests/extension --config=tests/playwright.config.ts",
    "test:e2e": "npm run build && npm run test:playwright",
    "format": "prettier .  --write"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@tailwindcss/typography": "^0.5.20",
    "fakes3-sdk": "^0.1.4",
    "jsdom": "*",
    "playwright": "*"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "@myz/core": "*",
    "@myz/dashboard-ui": "*",
    "@myz/shared": "*",
    "@myz/sync-core": "*",
    "@noble/curves": "*",
    "defuddle": "^0.19.2",
    "dompurify": "^3.4.12",
    "fflate": "*",
    "markdown-it": "^14.3.3",
    "pdfjs-dist": "^6.3.289"
  }
}
