{
  "name": "myz-annotator",
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint --ext .js,.jsx --fix",
    "test:dev": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:playwright": "playwright test tests --config=tests/playwright.config.ts",
    "test:e2e": "npm run build && npm run test:playwright",
    "format": "prettier .  --write"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.1",
    "@eslint/compat": "^1.4.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1",
    "extension": "^2.1.3",
    "jest": "^30.2.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.5",
    "vite-plugin-zip-pack": "^1.2.4",
    "vue-tsc": "^3.1.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "markdown-it": "^14.1.0",
    "tailwindcss": "^4.1.17",
    "vectoria": "file:../vectoria",
    "vue": "^3.5.22"
  }
}
