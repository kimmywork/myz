{
  "name": "myz-annotator",
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx --fix",
    "test:dev": "vitest run",
    "test:playwright": "playwright test tests/extension --config=tests/playwright.config.ts",
    "test:e2e": "npm run build && npm run test:playwright",
    "format": "prettier .  --write"
  },
  "devDependencies": {
    "extension": "*",
    "jest": "*",
    "jsdom": "*",
    "playwright": "*"
  },
  "dependencies": {
    "@myz/dashboard-core": "*",
    "@myz/dashboard-ui": "*",
    "@myz/shared": "*",
    "@myz/sync-core": "*",
    "@noble/curves": "*",
    "fflate": "*",
    "hash-wasm": "*",
    "markdown-it": "*"
  }
}
