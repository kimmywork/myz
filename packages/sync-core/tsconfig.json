{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "@myz/shared": ["packages/shared/src/index.ts"],
      "@myz/shared/*": ["packages/shared/src/*"],
      "@myz/sync-core": ["packages/sync-core/src/index.ts"],
      "@myz/sync-core/*": ["packages/sync-core/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
